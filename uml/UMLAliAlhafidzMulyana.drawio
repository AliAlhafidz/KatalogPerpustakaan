        <mxCell id="e_perpanjangan_peminjaman_diproses_oleh" parent="1" edge="1" source="r_perpanjangan_peminjaman_diproses_oleh" target="r_admin_id_admin" style="html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;startFill=0;endFill=0;startSize=11;endSize=11;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;startArrow=ERzeroToMany;endArrow=ERzeroToOne;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="SET NULL">
          <mxGeometry relative="1" as="geometry" x="-0.55" />
        </mxCell>
        <mxCell id="legend" parent="1" vertex="1" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;KETERANGAN ERD&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Notasi kolom&lt;/b&gt;&lt;ul style=&quot;margin:0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;PK&lt;/b&gt; primary key (huruf tebal) · &lt;b&gt;FK&lt;/b&gt; foreign key · &lt;b&gt;UK&lt;/b&gt; unique key (bisa komposit)&lt;/li&gt;&lt;li&gt;&lt;b&gt;?&lt;/b&gt; di belakang tipe = kolom boleh NULL · &lt;b&gt;GEN&lt;/b&gt; = kolom turunan (generated)&lt;/li&gt;&lt;li&gt;Judul tabel: &lt;i&gt;nama_tabel&lt;/i&gt; (nama class di Class Diagram)&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;b&gt;Notasi garis&lt;/b&gt;&lt;ul style=&quot;margin:0;padding-left:16px&quot;&gt;&lt;li&gt;Garis dimulai dari &lt;b&gt;kolom FK&lt;/b&gt; (sisi anak, kaki gagak “0..*”) dan berakhir di &lt;b&gt;kolom PK&lt;/b&gt; tabel induk.&lt;/li&gt;&lt;li&gt;Ujung induk: &lt;b&gt;||&lt;/b&gt; = tepat 1 (FK NOT NULL), &lt;b&gt;o|&lt;/b&gt; = 0..1 (FK boleh NULL).&lt;/li&gt;&lt;li&gt;Teks pada garis = aturan &lt;b&gt;ON DELETE&lt;/b&gt; pada induk.&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;b&gt;Daftar relasi (14 foreign key)&lt;/b&gt;&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;2&quot; style=&quot;border-collapse:collapse;font-size:9px;width:100%&quot;&gt;&lt;tr&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Kolom FK (anak)&lt;/th&gt;&lt;th&gt;Kolom PK (induk)&lt;/th&gt;&lt;th&gt;Induk : Anak&lt;/th&gt;&lt;th&gt;ON DELETE&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;audit_log.user_id&lt;/td&gt;&lt;td&gt;admin.id_admin&lt;/td&gt;&lt;td&gt;0..1 : 0..*&lt;/td&gt;&lt;td&gt;SET NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;buku.id_kategori&lt;/td&gt;&lt;td&gt;kategori.id_kategori&lt;/td&gt;&lt;td&gt;0..1 : 0..*&lt;/td&gt;&lt;td&gt;SET NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;favorit.id_anggota&lt;/td&gt;&lt;td&gt;anggota.id_anggota&lt;/td&gt;&lt;td&gt;1 : 0..*&lt;/td&gt;&lt;td&gt;CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;favorit.id_buku&lt;/td&gt;&lt;td&gt;buku.id_buku&lt;/td&gt;&lt;td&gt;1 : 0..*&lt;/td&gt;&lt;td&gt;CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;notifikasi.id_anggota&lt;/td&gt;&lt;td&gt;anggota.id_anggota&lt;/td&gt;&lt;td&gt;1 : 0..*&lt;/td&gt;&lt;td&gt;CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;peminjaman.id_anggota&lt;/td&gt;&lt;td&gt;anggota.id_anggota&lt;/td&gt;&lt;td&gt;1 : 0..*&lt;/td&gt;&lt;td&gt;RESTRICT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;peminjaman.id_buku&lt;/td&gt;&lt;td&gt;buku.id_buku&lt;/td&gt;&lt;td&gt;0..1 : 0..*&lt;/td&gt;&lt;td&gt;SET NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;peminjaman.diproses_oleh&lt;/td&gt;&lt;td&gt;admin.id_admin&lt;/td&gt;&lt;td&gt;0..1 : 0..*&lt;/td&gt;&lt;td&gt;SET NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;pengajuan_peminjaman.id_anggota&lt;/td&gt;&lt;td&gt;anggota.id_anggota&lt;/td&gt;&lt;td&gt;1 : 0..*&lt;/td&gt;&lt;td&gt;CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;pengajuan_peminjaman.id_buku&lt;/td&gt;&lt;td&gt;buku.id_buku&lt;/td&gt;&lt;td&gt;1 : 0..*&lt;/td&gt;&lt;td&gt;CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;pengajuan_peminjaman.diproses_oleh&lt;/td&gt;&lt;td&gt;admin.id_admin&lt;/td&gt;&lt;td&gt;0..1 : 0..*&lt;/td&gt;&lt;td&gt;SET NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;perpanjangan_peminjaman.id_peminjaman&lt;/td&gt;&lt;td&gt;peminjaman.id_peminjaman&lt;/td&gt;&lt;td&gt;1 : 0..*&lt;/td&gt;&lt;td&gt;CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;13&lt;/td&gt;&lt;td&gt;perpanjangan_peminjaman.id_anggota&lt;/td&gt;&lt;td&gt;anggota.id_anggota&lt;/td&gt;&lt;td&gt;1 : 0..*&lt;/td&gt;&lt;td&gt;CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;perpanjangan_peminjaman.diproses_oleh&lt;/td&gt;&lt;td&gt;admin.id_admin&lt;/td&gt;&lt;td&gt;0..1 : 0..*&lt;/td&gt;&lt;td&gt;SET NULL&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Nilai ENUM&lt;/b&gt;&lt;ul style=&quot;margin:0;padding-left:16px&quot;&gt;&lt;li&gt;&lt;b&gt;anggota.status&lt;/b&gt;: aktif,nonaktif&lt;/li&gt;&lt;li&gt;&lt;b&gt;audit_log.aksi&lt;/b&gt;: tambah,edit,hapus&lt;/li&gt;&lt;li&gt;&lt;b&gt;notifikasi.tipe&lt;/b&gt;: info,success,warning,danger&lt;/li&gt;&lt;li&gt;&lt;b&gt;peminjaman.status&lt;/b&gt;: dipinjam,dikembalikan&lt;/li&gt;&lt;li&gt;&lt;b&gt;pengajuan_peminjaman.status&lt;/b&gt;: menunggu,disetujui,ditolak,dibatalkan&lt;/li&gt;&lt;li&gt;&lt;b&gt;perpanjangan_peminjaman.status&lt;/b&gt;: menunggu,disetujui,ditolak&lt;/li&gt;&lt;/ul&gt;&lt;br&gt;&lt;b&gt;Catatan&lt;/b&gt;&lt;ul style=&quot;margin:0;padding-left:16px&quot;&gt;&lt;li&gt;Anggota–Buku bersifat M:N, diselesaikan oleh &lt;b&gt;favorit&lt;/b&gt;, &lt;b&gt;peminjaman&lt;/b&gt;, dan &lt;b&gt;pengajuan_peminjaman&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;favorit&lt;/b&gt;: UNIQUE (id_anggota, id_buku). &lt;b&gt;notifikasi&lt;/b&gt;: UNIQUE (id_anggota, kunci_unik).&lt;/li&gt;&lt;li&gt;&lt;b&gt;pengajuan_peminjaman.aktif_unik&lt;/b&gt; dibentuk otomatis (hanya terisi saat status “menunggu”) dan UNIQUE, sehingga satu anggota tidak bisa punya dua pengajuan menunggu untuk buku yang sama. Kolom ini tidak digambar di Class Diagram.&lt;/li&gt;&lt;li&gt;&lt;b&gt;peminjaman.id_buku&lt;/b&gt; bisa NULL dengan ON DELETE SET NULL: hapus buku yang masih dipinjam ditolak; hapus buku yang sudah dikembalikan diizinkan, riwayat peminjaman tetap tersimpan dengan id_buku NULL.&lt;/li&gt;&lt;li&gt;&lt;b&gt;perpanjangan_peminjaman.id_anggota&lt;/b&gt; menyalin pemilik dari peminjaman (denormalisasi untuk filter cepat).&lt;/li&gt;&lt;li&gt;&lt;b&gt;audit_log.target_tabel + target_id&lt;/b&gt; menunjuk baris tabel lain secara logis (tanpa FK).&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;fontSize=10;fontColor=#000000;spacing=10;rounded=0;">
          <mxGeometry x="1780" y="40" width="620" height="900" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" vertex="1" value="ERD: Sistem Informasi Perpustakaan Umum (10 tabel, 14 relasi)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#000000;strokeColor=none;fillColor=none;">
          <mxGeometry x="120" y="-10" width="900" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
