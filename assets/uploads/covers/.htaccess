# Mencegah eksekusi script di folder upload (hardened)
<FilesMatch "\.(php|php5|phtml|phar|inc|pht)$">
    Require all denied
</FilesMatch>
# Matikan engine PHP bila modul masih aktif
<IfModule mod_php5.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
# Cegah listing direktori
Options -Indexes
# Hanya izinkan file gambar
<FilesMatch "\.(jpg|jpeg|png|webp|svg)$">
    Require all granted
</FilesMatch>
